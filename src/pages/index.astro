---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfileHeader from '@/components/ProfileHeader.astro';
import ContributionGraph from '@/components/ContributionGraph.astro';
import GitHubProjectCard from '@/components/GitHubProjectCard.astro';
import ResumeCard from '@/components/ResumeCard.astro';
import { DATA } from '@/data/resume';
import { loadGitHub } from '@/lib/github';

const github = await loadGitHub();

const aboutHtml = DATA.summary
  .replace(/\n\n/g, '</p><p>')
  .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
---

<BaseLayout>
  <main class="home">
    <ProfileHeader
      name={github.user.name}
      login={github.user.login}
      avatar={github.avatar}
      banner={github.banner}
      githubUrl={github.user.url}
    />

    <section class="surface fade-in" style="animation-delay: 0.06s" id="about">
      <h2>About</h2>
      <div class="about-text" set:html={`<p>${aboutHtml}</p>`} />
    </section>

    <section class="surface fade-in" style="animation-delay: 0.12s" id="education">
      <h2>Academic background</h2>
      <div class="card-list">
        {DATA.education.map((edu) => (
          <ResumeCard
            title={edu.degree}
            subtitle={edu.school}
            period={`${edu.start} — ${edu.end}`}
          />
        ))}
      </div>
    </section>

    <ContributionGraph calendar={github.calendar} publicRepos={github.user.publicRepos} />

    <section class="surface fade-in" style="animation-delay: 0.24s" id="projects">
      <h2>Projects</h2>
      <div class="gh-list">
        {github.repos.map((repo) => (
          <GitHubProjectCard repo={repo} />
        ))}
      </div>
    </section>

    <section class="surface fade-in" style="animation-delay: 0.3s" id="cubing">
      <h2>Cubing</h2>
      <div class="card-list">
        {DATA.cubing.map((item) => (
          <ResumeCard
            title={item.organization}
            url={item.url}
            subtitle={item.title}
            period={`${item.start} — ${item.end}`}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
