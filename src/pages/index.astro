---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DATA } from '@/data/resume';

const aboutParagraphs = DATA.summary.split('\n\n');
---

<BaseLayout>
  <main class="page">
    <div class="name-row">
      <span class="name-logo">
        <img src="/avatar.png?v=4" alt="" width="1024" height="1024" />
      </span>
      <h1 class="name">{DATA.name}</h1>
    </div>
    <p class="tagline">{DATA.description}</p>

    <div class="about">
      {aboutParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <p class="links">
      <a href={DATA.contact.social.GitHub.url} target="_blank" rel="noopener noreferrer">GitHub</a>
      {' | '}
      <a href={DATA.contact.social.LinkedIn.url} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      {' | '}
      <a href="/blog/">Blog</a>
    </p>

    <section>
      <h2>Education</h2>
      <div class="plain-list">
        {DATA.education.map((edu) => (
          <p>{edu.degree} - {edu.school}, {edu.end}</p>
        ))}
      </div>
    </section>

    <section>
      <h2>Projects</h2>
      <div class="plain-list">
        {DATA.projects.map((project) => (
          <p>
            <a href={project.url} target="_blank" rel="noopener noreferrer">{project.title}</a>
            {' - '}{project.description}
          </p>
        ))}
      </div>
    </section>

    <section>
      <h2>Cubing</h2>
      <div class="plain-list">
        {DATA.cubing.map((item) => (
          <p>{item}</p>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
