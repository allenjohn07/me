---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BackLink from '@/components/BackLink.astro';
import Badge from '@/components/Badge.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="Blog posts by Allen John">
  <main class="page">
    <div class="page-header">
      <h1 class="name">Blog</h1>
      <BackLink href="/" label="home" />
    </div>

    {posts.length === 0 ? (
      <p class="empty-copy">No posts yet. Check back soon!</p>
    ) : (
      <ul class="blog-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`} class="blog-row">
              <time class="blog-date" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', {
                  timeZone: 'UTC',
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <span class="blog-row-body">
                <span class="blog-row-title">{post.data.title}</span>
                {post.data.description && (
                  <span class="blog-desc">{post.data.description}</span>
                )}
                {post.data.tags.length > 0 && (
                  <span class="badge-list blog-tags">
                    {post.data.tags.map((tag) => (
                      <Badge label={tag} />
                    ))}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>
