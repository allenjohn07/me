---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/Badge.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="Blog posts by Allen John">
  <main class="home">
    {posts.length === 0 ? (
      <section class="surface fade-in">
        <a href="/" class="back-link">← Home</a>
        <p class="empty-copy">No posts yet. Check back soon!</p>
      </section>
    ) : (
      <section class="surface fade-in">
        <a href="/" class="back-link">← Home</a>
        <div class="blog-list">
          {posts.map((post) => (
            <article class="blog-card">
              <div class="blog-card-top">
                <h2>
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </h2>
                <time class="blog-date" datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </div>
              {post.data.description && (
                <p class="blog-desc">{post.data.description}</p>
              )}
              {post.data.tags.length > 0 && (
                <div class="badge-list blog-tags">
                  {post.data.tags.map((tag) => (
                    <Badge label={tag} />
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
